PORT=5001

MONGODB_URI=your_mongodb_connection_string

JWT_SECRET=your_jwt_secret

CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# development | production
NODE_ENV=development

# Comma-free list is not supported; set ONE allowed frontend origin for CORS in production.
# In non-production, http://localhost:5173 is always allowed automatically.
CLIENT_URL=https://your-frontend-domain.com

# --- AI Reply Suggestions (optional) ---
# Backend-only secrets. Never expose these to the frontend.
# If neither key is set, or the provider fails, built-in fallback suggestions are used.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
